{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Companionship",
        "Food",
        "Home",
        "Skill Sharing",
        "Technology",
        "Transportation",
        "Creative Workshops"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "In-person",
        "Remote",
        "Hybrid"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "capacity": {
      "type": "number"
    },
    "applicants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "draft"
      ],
      "default": "active"
    },
    "created_by_name": {
      "type": "string"
    },
    "remarks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author_id": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "required": [
    "title",
    "description",
    "organization",
    "cause_category"
  ]
}