{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Transportation & Escort",
        "Combating Loneliness",
        "Food Preparation & Delivery",
        "Technological Assistance",
        "Maintenance & Home Repair",
        "Learning & Skills Workshops",
        "Trauma & Emotional Support",
        "Community Events",
        "Other"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "In-person",
        "Remote",
        "Hybrid"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "applicants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "draft"
      ],
      "default": "active"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "organization",
    "cause_category"
  ]
}