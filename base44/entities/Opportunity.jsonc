{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Environment",
        "Education",
        "Health",
        "Animals",
        "Community",
        "Elderly",
        "Youth",
        "Disaster Relief",
        "Arts & Culture",
        "Other"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "In-person",
        "Remote",
        "Hybrid"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "applicants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "draft"
      ],
      "default": "active"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "organization",
    "cause_category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "moderator"
          ]
        }
      }
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "moderator"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "moderator"
              ]
            }
          }
        }
      ]
    }
  }
}