{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Companionship",
        "Food",
        "Home",
        "Skill Sharing",
        "Technology",
        "Transportation",
        "Creative Workshops"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "In-person",
        "Remote",
        "Hybrid"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "capacity": {
      "type": "number"
    },
    "applicants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "draft"
      ],
      "default": "active"
    },
    "created_by_name": {
      "type": "string"
    },
    "created_by_id": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "organization",
    "cause_category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}