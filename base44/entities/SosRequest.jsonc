{
  "name": "SosRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Food",
        "Companionship",
        "Home",
        "Skill Sharing",
        "Technology",
        "Transportation"
      ]
    },
    "urgency_hours": {
      "type": "number",
      "enum": [
        24,
        48
      ],
      "default": 24
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "claimed",
        "resolved"
      ],
      "default": "open"
    },
    "claimed_by_id": {
      "type": "string"
    },
    "claimed_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "contact_name"
  ]
}