{
  "name": "SosRequest",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Companionship",
        "Food",
        "Home",
        "Skill Sharing",
        "Technology",
        "Transportation",
        "Other"
      ]
    },
    "urgency_hours": {
      "type": "number",
      "enum": [
        24,
        48
      ],
      "default": 24
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "claimed",
        "resolved"
      ],
      "default": "open"
    },
    "claimed_by_id": {
      "type": "string"
    },
    "claimed_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "contact_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.claimed_by_id": "{{user.id}}"
        },
        {
          "data.claimed_by_id": null
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}