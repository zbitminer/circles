{
  "name": "Post",
  "type": "object",
  "properties": {
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comment_count": {
      "type": "number",
      "default": 0
    },
    "cause_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "removed",
        "flagged"
      ],
      "default": "active"
    },
    "reported_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "content"
  ]
}