{
  "name": "MentorshipMatch",
  "type": "object",
  "properties": {
    "mentor_id": {
      "type": "string"
    },
    "mentor_name": {
      "type": "string"
    },
    "mentee_id": {
      "type": "string"
    },
    "mentee_name": {
      "type": "string"
    },
    "skill_area": {
      "type": "string"
    },
    "goals": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "accepted",
        "active",
        "completed",
        "declined"
      ],
      "default": "requested"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "mentor_id",
    "mentor_name",
    "mentee_id",
    "mentee_name",
    "skill_area"
  ],
  "rls": {
    "create": {
      "data.mentee_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.mentor_id": "{{user.id}}"
        },
        {
          "data.mentee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.mentor_id": "{{user.id}}"
        },
        {
          "data.mentee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.mentor_id": "{{user.id}}"
        },
        {
          "data.mentee_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}