{
  "name": "VolunteerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_hours": {
      "type": "number",
      "default": 0
    },
    "events_attended": {
      "type": "number",
      "default": 0
    },
    "opportunities_completed": {
      "type": "number",
      "default": 0
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "following": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "phone_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "private"
    },
    "location_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "bio_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}