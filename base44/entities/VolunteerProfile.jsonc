{
  "name": "VolunteerProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "data.phone_visibility": "public"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        "write": {
          "$or": [
            {
              "data.user_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_hours": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "events_attended": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "opportunities_completed": {
      "type": "number",
      "default": 0,
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "followers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "following": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "phone_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "private"
    },
    "location_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "bio_visibility": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "data.user_id": "{{user.id}}"
    },
    "delete": {
      "data.user_id": "{{user.id}}"
    }
  }
}
