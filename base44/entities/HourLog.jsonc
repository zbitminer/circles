{
  "name": "HourLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "activity_name": {
      "type": "string"
    },
    "hours": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Transportation & Escort",
        "Combating Loneliness",
        "Food Preparation & Delivery",
        "Technological Assistance",
        "Maintenance & Home Repair",
        "Learning & Skills Workshops",
        "Trauma & Emotional Support",
        "Community Events",
        "Other"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "activity_name",
    "hours",
    "date"
  ]
}