{
  "name": "HourLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "activity_name": {
      "type": "string"
    },
    "hours": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 24
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Companionship",
        "Food",
        "Home",
        "Skill Sharing",
        "Technology",
        "Transportation"
      ]
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "user_id",
    "activity_name",
    "hours",
    "date"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.status": "pending"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
