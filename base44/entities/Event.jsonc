{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "string"
    },
    "cause_category": {
      "type": "string",
      "enum": [
        "Arts & Crafts",
        "Personal Development",
        "Languages",
        "Health & Wellness",
        "Music",
        "Cooking",
        "Support Groups",
        "Other"
      ]
    },
    "capacity": {
      "type": "number"
    },
    "image_url": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "ongoing",
        "completed",
        "cancelled"
      ],
      "default": "upcoming"
    },
    "created_by_name": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "date",
    "location",
    "cause_category"
  ]
}